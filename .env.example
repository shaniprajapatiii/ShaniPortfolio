# Live coding platform handles
GITHUB_USERNAME=your_github_username
LEETCODE_USERNAME=your_leetcode_username
CODEFORCES_HANDLE=your_codeforces_handle
CODECHEF_HANDLE=your_codechef_handle

# Mailer configuration
MAILER_HOST=smtp.example.com
MAILER_PORT=465
MAILER_SECURE=false
MAILER_USER=your_smtp_username
MAILER_PASS=your_smtp_password
MAILER_FROM="Portfolio Contact <no-reply@example.com>"
MAILER_TO=your.email@example.com
# Optional: use a provider service name instead of host/port
# MAILER_SERVICE=SendGrid
